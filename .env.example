ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./hotel_agent.db
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SEED_DEMO=true

# Text model: any OpenAI-compatible endpoint with tool calling (OpenRouter by default).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# "off" disables hidden reasoning on reasoning models: ~2x faster first token in our benchmark.
LLM_REASONING=off
# Local alternative (scripts/run_llm.sh, fits next to ASR on a 6 GB GPU):
# LLM_BASE_URL=http://localhost:8003/v1
# LLM_API_KEY=local
# LLM_MODEL=qwen3.5-2b
# LLM_REASONING=
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}, "presence_penalty": 1.0, "top_p": 0.8, "top_k": 20}
EMBEDDING_MODEL=

# Speech: scripts/run_asr.sh (vLLM, ~/vllm-env) and scripts/run_tts.sh (Kokoro, ~/kokoro-env)
ASR_BASE_URL=http://localhost:8001/v1
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
TTS_BASE_URL=http://localhost:8002/v1
TTS_MODEL=oddadmix/Kokoro-7M-Distill
TTS_VOICE=af_msa
# Kokoro-7M speaks English only; add languages when you add voices for them.
TTS_LANGUAGES=en
TTS_PREFETCH=2
